{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F7Hub search_terms planning catalog v0.1",
  "description": "Planning fixtures only. JSON Schema validates structure, not semantic authority or foreign keys.",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_kind",
    "catalog_status",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "catalog_kind": {
      "const": "search_terms"
    },
    "catalog_status": {
      "const": "planning_proposal"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "language",
          "text",
          "lookup_form",
          "usages",
          "review_status"
        ],
        "properties": {
          "language": {
            "enum": [
              "en",
              "fr",
              "und"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "lookup_form": {
            "type": "string",
            "minLength": 1
          },
          "usages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "role",
                "record_ref",
                "source_field"
              ],
              "properties": {
                "role": {
                  "type": "string"
                },
                "record_ref": {
                  "type": "string"
                },
                "source_field": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "review_status": {
            "const": "unreviewed"
          },
          "collision_review": {
            "type": "boolean"
          },
          "spelling_variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
